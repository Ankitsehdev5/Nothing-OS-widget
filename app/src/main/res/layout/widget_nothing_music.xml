<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nothing_widget"
    android:padding="14dp">

    <!-- Circular Album Art -->
    <ImageView
        android:id="@+id/iv_album_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_nothing_dots"
        android:contentDescription="@string/album_art_desc" />

    <!-- Swipeable Track Info Container -->
    <AdapterViewFlipper
        android:id="@+id/flipper_track"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@id/btn_play_pause"
        android:layout_toEndOf="@id/iv_album_art"
        android:autoStart="false" />

    <!-- Invisible Left/Right Touch Zones for Reliable Prev/Next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toStartOf="@id/btn_play_pause"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/zone_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/prev_track_desc" />

        <ImageButton
            android:id="@+id/zone_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/next_track_desc" />
    </LinearLayout>

    <!-- Only Visible Control: Play / Pause Toggle -->
    <ImageButton
        android:id="@+id/btn_play_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_play_pause_btn"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play"
        android:contentDescription="@string/play_pause_desc" />

</RelativeLayout>
